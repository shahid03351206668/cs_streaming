# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database (Docker: use service name "postgres"; local: use localhost)
DB_URI=host=localhost user=postgres password=yourpassword dbname=tasksy port=5432 sslmode=disable

# Redis (Docker: use service name "redis"; local: use 127.0.0.1)
REDIS_ADDR=127.0.0.1:6379

# JWT
JWT_SECRET=replace_with_a_long_random_string

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_API_KEY=pk_test_...
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_...

# AWS S3
AWS_S3_BUCKET_REGION=eu-north-1
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_BUCKET_URL=https://your-bucket.s3.eu-north-1.amazonaws.com
AWS_S3_USER_ACCESS_KEY_ID=AKIA...
AWS_S3_USER_SECRET=your_secret

# Firebase (paste the full service account JSON as a single line)
FIREBASE_CONFIG={"type":"service_account","project_id":"..."}

# Docker Compose (optional override for postgres password)
POSTGRES_PASSWORD=postgres
