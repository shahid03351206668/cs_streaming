# Ignore build and temporary files
tmp/
*.exe
*.out
*.test

# Ignore media files (large binary files)
media/

# Ignore Go build artifacts
*.a
*.so

# Ignore log files
*.log

# Ignore environment variable files
.env
.env.*

# Ignore IDE/editor files
.vscode/
.history/

# Optionally, ignore the Air live reloader config if you don't want to track it
.air.toml
