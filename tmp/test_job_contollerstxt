package controllers

import (
	"net/http"
	"strconv"
	"time"

	"github.com/gin-gonic/gin"
	"gorm.io/gorm"
	"yourapp/models"
)

type JobController struct {
	DB *gorm.DB
}

func NewJobController(db *gorm.DB) *JobController {
	return &JobController{DB: db}
}

// CreateJobRequest represents the request body for creating a job
type CreateJobRequest struct {
	Title       string   `json:"title" binding:"required,min=3,max=255"`
	Description string   `json:"description" binding:"required,min=10"`
	Budget      float64  `json:"budget" binding:"min=0"`
	OpenBudget  bool     `json:"open_budget"`
	Address     string   `json:"address" binding:"max=500"`
	CategoryID  uint     `json:"category_id" binding:"required"`
	MediaURLs   []string `json:"media_urls"`
}

// JobResponse represents a job in the response
type JobResponse struct {
	ID          uint                 `json:"id"`
	Title       string               `json:"title"`
	Description string               `json:"description"`
	Budget      float64              `json:"budget"`
	OpenBudget  bool                 `json:"open_budget"`
	Address     string               `json:"address"`
	CreatedAt   time.Time            `json:"created_at"`
	CreatedBy   UserResponse         `json:"created_by"`
	Category    CategoryResponse     `json:"category"`
	Media       []JobMediaResponse   `json:"media"`
}

type UserResponse struct {
	ID       uint   `json:"id"`
	Username string `json:"username"`
	FullName string `json:"full_name"`
}

type CategoryResponse struct {
	ID   uint   `json:"id"`
	Name string `json:"name"`
}

type JobMediaResponse struct {
	ID        uint   `json:"id"`
	URL       string `json:"url"`
	MediaType string `json:"media_type"`
}

// PaginatedJobResponse represents the paginated response
type PaginatedJobResponse struct {
	Jobs       []JobResponse `json:"jobs"`
	NextCursor *uint         `json:"next_cursor"` // nil if no more pages
	HasMore    bool          `json:"has_more"`
	Limit      int           `json:"limit"`
}

// CreateJob creates a new job post
func (jc *JobController) CreateJob(c *gin.Context) {
	var req CreateJobRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	// Get user ID from context (assuming auth middleware sets this)
	userID, exists := c.Get("user_id")
	if !exists {
		c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"})
		return
	}

	// Verify category exists
	var category models.Category
	if err := jc.DB.First(&category, req.CategoryID).Error; err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid category"})
		return
	}

	// Create job post
	job := models.JobPost{
		CreatedByID: userID.(uint),
		CategoryID:  req.CategoryID,
		Title:       req.Title,
		Description: req.Description,
		Budget:      req.Budget,
		OpenBudget:  req.OpenBudget,
		Address:     req.Address,
	}

	// Start transaction
	tx := jc.DB.Begin()
	if err := tx.Create(&job).Error; err != nil {
		tx.Rollback()
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to create job"})
		return
	}

	// Create media entries
	if len(req.MediaURLs) > 0 {
		for _, url := range req.MediaURLs {
			mediaType := detectMediaType(url)
			media := models.JobMedia{
				JobID:     job.ID,
				URL:       url,
				MediaType: mediaType,
			}
			if err := tx.Create(&media).Error; err != nil {
				tx.Rollback()
				c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to create media"})
				return
			}
		}
	}

	tx.Commit()

	// Load complete job with relations
	var createdJob models.JobPost
	jc.DB.Preload("CreatedBy").Preload("Category").Preload("JobMedia").First(&createdJob, job.ID)

	c.JSON(http.StatusCreated, gin.H{
		"message": "Job created successfully",
		"job":     transformJobToResponse(createdJob),
	})
}

// ListJobs returns paginated jobs using cursor-based pagination (like Google Shorts)
func (jc *JobController) ListJobs(c *gin.Context) {
	// Parse cursor (ID of last item from previous page)
	cursorStr := c.Query("cursor")
	var cursor uint
	if cursorStr != "" {
		parsed, err := strconv.ParseUint(cursorStr, 10, 32)
		if err != nil {
			c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid cursor"})
			return
		}
		cursor = uint(parsed)
	}

	// Parse limit (default 10, max 50)
	limitStr := c.DefaultQuery("limit", "10")
	limit, err := strconv.Atoi(limitStr)
	if err != nil || limit < 1 || limit > 50 {
		limit = 10
	}

	// Optional filters
	categoryID := c.Query("category_id")

	// Build query
	query := jc.DB.Model(&models.JobPost{}).
		Preload("CreatedBy").
		Preload("Category").
		Preload("JobMedia").
		Order("id DESC")

	// Apply cursor
	if cursor > 0 {
		query = query.Where("id < ?", cursor)
	}

	// Apply category filter
	if categoryID != "" {
		query = query.Where("category_id = ?", categoryID)
	}

	// Fetch limit + 1 to check if there are more results
	var jobs []models.JobPost
	if err := query.Limit(limit + 1).Find(&jobs).Error; err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to fetch jobs"})
		return
	}

	// Check if there are more results
	hasMore := len(jobs) > limit
	if hasMore {
		jobs = jobs[:limit] // Remove the extra item
	}

	// Prepare response
	jobResponses := make([]JobResponse, len(jobs))
	for i, job := range jobs {
		jobResponses[i] = transformJobToResponse(job)
	}

	// Determine next cursor
	var nextCursor *uint
	if hasMore && len(jobs) > 0 {
		lastID := jobs[len(jobs)-1].ID
		nextCursor = &lastID
	}

	response := PaginatedJobResponse{
		Jobs:       jobResponses,
		NextCursor: nextCursor,
		HasMore:    hasMore,
		Limit:      limit,
	}

	c.JSON(http.StatusOK, response)
}

// GetJobByID returns a single job by ID
func (jc *JobController) GetJobByID(c *gin.Context) {
	jobID := c.Param("id")

	var job models.JobPost
	if err := jc.DB.Preload("CreatedBy").Preload("Category").Preload("JobMedia").
		First(&job, jobID).Error; err != nil {
		if err == gorm.ErrRecordNotFound {
			c.JSON(http.StatusNotFound, gin.H{"error": "Job not found"})
			return
		}
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to fetch job"})
		return
	}

	c.JSON(http.StatusOK, transformJobToResponse(job))
}

// Helper function to transform model to response
func transformJobToResponse(job models.JobPost) JobResponse {
	media := make([]JobMediaResponse, len(job.JobMedia))
	for i, m := range job.JobMedia {
		media[i] = JobMediaResponse{
			ID:        m.ID,
			URL:       m.URL,
			MediaType: m.MediaType,
		}
	}

	return JobResponse{
		ID:          job.ID,
		Title:       job.Title,
		Description: job.Description,
		Budget:      job.Budget,
		OpenBudget:  job.OpenBudget,
		Address:     job.Address,
		CreatedAt:   job.CreatedAt,
		CreatedBy: UserResponse{
			ID:       job.CreatedBy.ID,
			Username: job.CreatedBy.Username,
			FullName: job.CreatedBy.FullName,
		},
		Category: CategoryResponse{
			ID:   job.Category.ID,
			Name: job.Category.Name,
		},
		Media: media,
	}
}

// Helper function to detect media type from URL
func detectMediaType(url string) string {
	// Simple detection based on extension
	// In production, you might want to make actual HTTP requests or use more sophisticated detection
	if len(url) < 4 {
		return "unknown"
	}
	
	ext := url[len(url)-4:]
	switch ext {
	case ".jpg", ".jpeg", ".png", ".gif", ".webp":
		return "image"
	case ".mp4", ".webm", ".mov":
		return "video"
	case ".pdf", ".doc", "docx":
		return "document"
	default:
		return "other"
	}
}