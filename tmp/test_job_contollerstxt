package routes

import (
	"yourapp/controllers"
	"yourapp/middleware"

	"github.com/gin-gonic/gin"
	"gorm.io/gorm"
)

// SetupJobRoutes configures all job-related routes
func SetupJobRoutes(router *gin.Engine, db *gorm.DB) {
	jobController := controllers.NewJobController(db)

	// Public routes
	publicJobs := router.Group("/api/v1/jobs")
	{
		// List jobs with cursor pagination
		// Example: GET /api/v1/jobs?cursor=123&limit=10&category_id=5
		publicJobs.GET("", jobController.ListJobs)

		// Get single job
		// Example: GET /api/v1/jobs/123
		publicJobs.GET("/:id", jobController.GetJobByID)
	}

	// Protected routes (require authentication)
	protectedJobs := router.Group("/api/v1/jobs")
	protectedJobs.Use(middleware.AuthMiddleware()) // Your auth middleware
	{
		// Create new job
		// Example: POST /api/v1/jobs
		protectedJobs.POST("", jobController.CreateJob)
	}
}

